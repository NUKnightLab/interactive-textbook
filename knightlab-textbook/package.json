{
  "name": "knightlab-textbook",
  "displayName": "Knight Lab Textbook",
  "description": "Interactive course textbook",
  "version": "0.0.1",
  "publisher": "knight-lab",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "activationEvents": [
    "workspaceContains:chapters/**",
    "onCommand:knightlab.openTextbook",
    "onCommand:knightlab.updateTextbook"
  ],
  "contributes": {
    "commands": [
      {
        "command": "knightlab.openTextbook",
        "title": "Knight Lab: Open Textbook"
      },
      {
        "command": "knightlab.updateTextbook",
        "title": "Knight Lab: Update Textbook"
      }
    ]
  }
}
